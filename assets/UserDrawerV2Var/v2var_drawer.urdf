<?xml version="1.0"?>
<!-- Generated by scripts/make_drawer_asset.py from robot.urdf.
     Geometry baked +90 deg about z so the slide axis is +X, matching the
     convention every offset in drawer_open_place/action_config.json assumes.
     handle_xpos is derived from the tray geometry, not hand-placed.
     Collision shapes are a CoACD decomposition of the same baked meshes. -->
<robot name="v2var_drawer">
  <link name="outer_box">
    <inertial><origin xyz="0.000000 0.000000 0.065000" rpy="0 0 0"/>
      <mass value="0.62"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.006"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/base_band_baked.obj"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/base_band_acd.obj"/></geometry></collision>
  </link>

  <link name="inner_box">
    <inertial><origin xyz="0.012607 -0.000000 0.076550" rpy="0 0 0"/>
      <mass value="0.34"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.003"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/drawer_baked.obj"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/drawer_acd.obj"/></geometry></collision>
  </link>

  <link name="handle_xpos"/>

  <joint name="slide_rails" type="prismatic">
    <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0"/>
    <parent link="outer_box"/><child link="inner_box"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-0.125" upper="0.0" effort="25.0" velocity="1.0" acceleration="5.0"/>
  </joint>

  <joint name="fixed_handle" type="fixed">
    <origin xyz="0.096750 0.000000 0.064100" rpy="0 -1.5707963268 0"/>
    <parent link="inner_box"/><child link="handle_xpos"/>
  </joint>
</robot>
