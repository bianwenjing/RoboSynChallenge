<?xml version="1.0"?>
<!-- Generated by scripts/make_drawer_asset.py from robot.urdf.
     Geometry baked +90 deg about z so the slide axis is +X, matching the
     convention every offset in drawer_open_place/action_config.json assumes.
     handle_xpos is derived from the tray geometry, not hand-placed.
     Collision shapes are a CoACD decomposition of the same baked meshes. -->
<robot name="walnut_drawer">
  <link name="outer_box">
    <inertial><origin xyz="0.002500 -0.000000 0.077500" rpy="0 0 0"/>
      <mass value="2.3"/>
      <inertia ixx="0.011523958" ixy="0" ixz="0" iyy="0.016109583" iyz="0" izz="0.018423958"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/plinth_base_baked.obj"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/plinth_base_acd.obj"/></geometry></collision>
  </link>

  <link name="inner_box">
    <inertial><origin xyz="0.010858 0.000296 0.042372" rpy="0 0 0"/>
      <mass value="1.1"/>
      <inertia ixx="0.002758494" ixy="0" ixz="0" iyy="0.005598213" iyz="0" izz="0.006774465"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/drawer_bottom_panel_baked.obj"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/drawer_bottom_panel_acd.obj"/></geometry></collision>
  </link>

  <link name="handle_xpos"/>

  <joint name="slide_rails" type="prismatic">
    <origin xyz="-0.003358 -0.000296 0.036178" rpy="0 0 0"/>
    <parent link="outer_box"/><child link="inner_box"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-0.13" upper="0.0" effort="25.0" velocity="1.0" acceleration="5.0"/>
  </joint>

  <joint name="fixed_handle" type="fixed">
    <origin xyz="0.116000 0.020000 0.048000" rpy="0 -1.5707963268 0"/>
    <parent link="inner_box"/><child link="handle_xpos"/>
  </joint>
</robot>
