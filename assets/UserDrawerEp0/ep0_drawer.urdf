<?xml version="1.0"?>
<!-- Generated by scripts/make_drawer_asset.py from robot.urdf.
     Geometry baked +90 deg about z so the slide axis is +X, matching the
     convention every offset in drawer_open_place/action_config.json assumes.
     handle_xpos is derived from the tray geometry, not hand-placed.
     Collision shapes are a CoACD decomposition of the same baked meshes. -->
<robot name="ep0_drawer">
  <link name="outer_box">
    <inertial><origin xyz="0.000000 0.000000 0.045000" rpy="0 0 0"/>
      <mass value="0.7"/>
      <inertia ixx="0.002833917" ixy="0" ixz="0" iyy="0.004118333" iyz="0" izz="0.006007251"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/outer_shell_baked.obj"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/outer_shell_acd.obj"/></geometry></collision>
  </link>

  <link name="inner_box">
    <inertial><origin xyz="0.009980 -0.000000 0.040000" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.001476936" ixy="0" ixz="0" iyy="0.00254207" iyz="0" izz="0.003592339"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/drawer_tray_baked.obj"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/drawer_tray_acd.obj"/></geometry></collision>
  </link>

  <link name="handle_xpos"/>

  <joint name="slide_rails" type="prismatic">
    <origin xyz="0.003350 -0.000000 0.006500" rpy="0 0 0"/>
    <parent link="outer_box"/><child link="inner_box"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-0.245" upper="0.0" effort="25.0" velocity="1.0" acceleration="5.0"/>
  </joint>

  <joint name="fixed_handle" type="fixed">
    <origin xyz="0.126637 -0.000000 0.020000" rpy="0 -1.5707963268 0"/>
    <parent link="inner_box"/><child link="handle_xpos"/>
  </joint>
</robot>
